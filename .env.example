# ─── Database (REQUIRED) ──────────────────────────────────
# Local: postgres://postgres:postgres@localhost:5432/aivc_national
# Vercel: use Neon, Supabase, or Vercel Postgres connection string.
# IMPORTANT: append ?sslmode=require for hosted providers.
DATABASE_URI=

# ─── Payload (REQUIRED) ───────────────────────────────────
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=

# Public site URL — used by metadata, sitemap, robots, OG tags.
# Vercel: set to your custom domain (e.g. https://aivc-ifuel.in).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Vercel Blob (REQUIRED on Vercel — Payload media) ─────
# Create a Blob store in the Vercel dashboard → Storage → Blob;
# Vercel auto-injects this token. Local dev without this token
# falls back to disk-based /media storage.
BLOB_READ_WRITE_TOKEN=

# ─── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Resend (transactional email) ─────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=AIVC <noreply@aivc-ifuel.in>

# ─── WhatsApp Cloud API ───────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# ─── Anthropic (Claude API — Session 9 AI features) ───────
# Without this, lead scoring / report narratives / smart FAQ
# return 503; the rest of the site continues to work.
ANTHROPIC_API_KEY=

# ─── Analytics (optional) ─────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ─── Admin notifications ──────────────────────────────────
ADMIN_EMAIL=admin@aivc-ifuel.in

# ─── Local dev shortcuts (DO NOT set on Vercel) ───────────
# Bypass auth gate on /portal and /admin-dashboard for UI dev.
# DEMO_PORTAL=true
# Force demo state-territory data instead of hitting Payload API.
# NEXT_PUBLIC_USE_DEMO_DATA=true
